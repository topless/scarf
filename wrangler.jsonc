// The site on Cloudflare Workers (#43, docs/observability.md "Hosting"): dist/ served as static
// assets at https://scarf.fan, no Worker script yet. The "Build feeds" workflow deploys it.
{
  "name": "scarf",
  "compatibility_date": "2026-10-30",
  "assets": { "directory": "./dist" },
  // Cloudflare keeps the DNS record and certificate for a custom domain itself.
  "routes": [{ "pattern": "scarf.fan", "custom_domain": true }],
  // The side-by-side copy at scarf.topless.workers.dev goes once scarf.fan answers here.
  "workers_dev": false,
  // Staging (#85): "Deploy staging" (.github/workflows/staging.yml) puts one branch, built from the
  // fixtures, on the Worker scarf-staging at https://staging.scarf.fan. Routes are inherited, so this
  // environment must name its own: left out, it would claim the scarf.fan custom domain for itself.
  "env": {
    "staging": {
      "name": "scarf-staging",
      "routes": [{ "pattern": "staging.scarf.fan", "custom_domain": true }]
    }
  }
}
